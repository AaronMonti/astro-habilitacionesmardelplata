---
const team = [
    { photo: "/about01.jpg", name: "Jorge Luis Toledo" },
    { photo: "/about02.jpg", name: "Romina Alejandra Moreno" },
];
---

<section class="bg-surface-muted py-20" id="nosotros">
    <div class="mx-auto max-w-[1200px] px-6">
        <div class="mb-16 text-center">
            <h2 class="mb-4 text-3xl font-bold leading-[1.3] text-text-heading">
                Nuestro equipo
            </h2>

            <div class="mx-auto h-1 w-16 rounded bg-brand-divider"></div>
        </div>

        <div class="grid items-center gap-16 md:grid-cols-2">
            {
                team.map((member) => (
                    <div class="team-member text-center">
                        <div class="mx-auto mb-4 max-w-sm overflow-hidden rounded-lg bg-surface-gray shadow-[0_4px_20px_rgba(0,0,0,.04)]">
                            <img
                                src={member.photo}
                                alt={member.name}
                                loading="lazy"
                                class="aspect-[3/4] w-full object-cover transition-transform duration-200 ease-out"
                            />
                        </div>
                        <h4 class="text-lg font-bold text-text-heading">
                            {member.name}
                        </h4>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    @media (hover: hover) and (pointer: fine) {
        .team-member:hover img {
            transform: scale(1.05);
        }
    }
</style>

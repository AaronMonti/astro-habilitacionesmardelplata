---
import "animate.css";
import { site } from "../config/site";

const navLinks = site.navigation;
const { instagram, linkedin } = site.contact;
---

<header id="navbar" class="fixed top-0 left-0 w-full z-50">
    <nav class="w-full">
        <div class="container mx-auto px-2 sm:px-6">
            <div class="relative flex justify-between items-center py-2">
                <!-- Insignia -->
                <span
                    class="animate__animated animate__fadeInDown animate__fast relative inline-flex items-center gap-2 overflow-hidden whitespace-nowrap rounded-full border bg-gradient-to-r from-brand-primary to-brand-accent px-4 py-1.5 text-[10px] md:text-[13px] font-semibold text-white shadow-lg shadow-brand-primary/25"
                >
                    <span
                        class="animate-shimmer absolute inset-y-0 left-0 w-10 -skew-x-12 bg-white/30 blur-sm"
                    ></span>
                    <i class="shrink-0 fa-solid fa-medal"></i>
                    <span class="shrink-0 flex items-center justify-center gap-1"
                        ><i class="fa-solid fa-plus text-[10px]"></i>20 años
                        acompañando en procesos de Habilitación</span
                    >
                </span>

                <!-- Menú desktop, centrado independientemente del logo y el CTA -->
                <ul
                    class="hidden md:flex items-center gap-1 absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2"
                >
                    {
                        navLinks.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    class="nav-link relative px-4 py-2 text-sm font-medium font-epilogue"
                                >
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>

                <!-- Redes + CTA (desktop) -->
                <div class="hidden md:flex items-center gap-3 shrink-0 ml-auto">
                    <a
                        href={instagram}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram"
                        class="social-icon social-icon--instagram flex items-center justify-center w-9 h-9 rounded-full"
                    >
                        <i class="text-base fa-brands fa-instagram"></i>
                    </a>
                    <a
                        href={linkedin}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="LinkedIn"
                        class="social-icon social-icon--linkedin flex items-center justify-center w-9 h-9 rounded-full"
                    >
                        <i class="text-base fa-brands fa-linkedin"></i>
                    </a>
                    <a
                        href="#contacto"
                        class="cta-btn ml-1 px-4 py-2 rounded text-sm font-semibold font-epilogue border"
                    >
                        Contactanos
                    </a>
                </div>

                <!-- Botón de menú móvil -->
                <button
                    class="menu-btn md:hidden flex items-center justify-center w-10 h-10 rounded-full"
                    id="menuButton"
                    type="button"
                    aria-label="Abrir menú"
                    aria-controls="mobileMenu"
                    aria-expanded="false"
                >
                    <svg
                        class="w-6"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>

            <!-- Menú móvil -->
            <div
                id="mobileMenu"
                data-open="false"
                inert
                class="md:hidden fixed inset-0 bg-surface-light z-50"
            >
                <div class="flex flex-col h-full">
                    <div class="flex justify-between items-center p-5">
                        <span
                            class="font-epilogue font-semibold text-brand-primary text-lg"
                        >
                            Habilitaciones MDP
                        </span>
                        <button
                            id="closeMenu"
                            type="button"
                            class="flex items-center justify-center w-10 h-10 bg-brand-primary text-white rounded-full transition-[transform,background-color] duration-200 ease-out active:scale-[0.97]"
                            aria-label="Cerrar menú"
                        >
                            <svg
                                class="w-6 pointer-events-none"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>

                    <ul
                        class="flex flex-col items-center justify-center flex-1 gap-6 text-2xl -mt-10"
                    >
                        {
                            navLinks.map((link) => (
                                <li>
                                    <a
                                        href={link.href}
                                        class="nav-link px-4 py-2 font-epilogue font-medium text-text-heading"
                                    >
                                        {link.label}
                                    </a>
                                </li>
                            ))
                        }
                    </ul>

                    <div class="flex justify-center gap-4 pb-10">
                        <a
                            href={instagram}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Instagram"
                            class="mobile-social flex items-center justify-center w-11 h-11 rounded-full bg-surface-muted text-brand-primary"
                        >
                            <i class="text-xl fa-brands fa-instagram"></i>
                        </a>
                        <a
                            href={linkedin}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="LinkedIn"
                            class="mobile-social flex items-center justify-center w-11 h-11 rounded-full bg-surface-muted text-brand-primary"
                        >
                            <i class="text-xl fa-brands fa-linkedin"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </nav>
</header>

<script>
    const navbar = document.getElementById("navbar");
    const menuButton = document.getElementById("menuButton");
    const closeMenuButton = document.getElementById("closeMenu");
    const mobileMenu = document.getElementById("mobileMenu");
    const mobileMenuLinks = mobileMenu?.querySelectorAll<HTMLAnchorElement>("a");

    const SCROLL_THRESHOLD = 40;
    const HIDE_THRESHOLD = 200;
    let isMenuOpen = false;
    let previousScrollY = window.scrollY;
    let scrollQueued = false;

    function updateNavbarState() {
        navbar?.classList.toggle("scrolled", window.scrollY > SCROLL_THRESHOLD);
    }

    // Oculta al bajar / muestra al subir; en móvil el header queda siempre visible
    function updateNavbarVisibility() {
        const currentScrollY = window.scrollY;
        const shouldHide =
            currentScrollY > previousScrollY &&
            currentScrollY > HIDE_THRESHOLD &&
            !isMenuOpen &&
            window.innerWidth >= 768;

        navbar?.classList.toggle("nav-hidden", shouldHide);
        previousScrollY = currentScrollY;
    }

    function onScroll() {
        if (scrollQueued) return;
        scrollQueued = true;
        requestAnimationFrame(() => {
            updateNavbarState();
            updateNavbarVisibility();
            scrollQueued = false;
        });
    }

    updateNavbarState();
    window.addEventListener("scroll", onScroll, { passive: true });

    function setMenuOpen(open: boolean, restoreFocus = false) {
        isMenuOpen = open;
        mobileMenu?.setAttribute("data-open", String(open));
        if (mobileMenu instanceof HTMLElement) mobileMenu.inert = !open;
        menuButton?.setAttribute("aria-expanded", String(open));
        document.body.classList.toggle("overflow-hidden", open);
        navbar?.classList.remove("nav-hidden");

        if (open) {
            closeMenuButton?.focus();
        } else if (restoreFocus) {
            menuButton?.focus();
        }
    }

    menuButton?.addEventListener("click", () => setMenuOpen(true));
    closeMenuButton?.addEventListener("click", () => setMenuOpen(false, true));

    mobileMenuLinks?.forEach((link) => {
        link.addEventListener("click", () => setMenuOpen(false));
    });

    document.addEventListener("keydown", (event) => {
        if (!isMenuOpen || !mobileMenu) return;

        if (event.key === "Escape") {
            setMenuOpen(false, true);
            return;
        }

        if (event.key !== "Tab") return;

        const focusable = Array.from(
            mobileMenu.querySelectorAll<HTMLElement>(
                'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
            ),
        );
        if (focusable.length === 0) return;

        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
        }
    });
</script>

<style is:global>
    #navbar {
        background-color: transparent;
        border-bottom: 1px solid transparent;
        transition:
            transform 220ms var(--ease-out),
            background-color 200ms ease,
            box-shadow 200ms ease,
            border-color 200ms ease;
    }

    #navbar.nav-hidden {
        transform: translateY(-100%);
    }

    #navbar .nav-link,
    #navbar .menu-btn {
        color: #ffffff;
        transition: color 200ms ease;
    }

    #navbar .menu-btn {
        background-color: rgba(255, 255, 255, 0.15);
    }

    #navbar .social-icon {
        color: #ffffff;
        background-color: rgba(255, 255, 255, 0.15);
        transition:
            transform 160ms var(--ease-out),
            background-color 160ms ease,
            color 160ms ease;
    }

    #navbar .cta-btn {
        color: #ffffff;
        border-color: rgba(255, 255, 255, 0.6);
        background-color: transparent;
        transition:
            transform 160ms var(--ease-out),
            background-color 160ms ease,
            border-color 160ms ease;
    }

    #navbar nav ul .nav-link::after {
        content: "";
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 100%;
        height: 2px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 200ms var(--ease-out);
    }

    @media (hover: hover) and (pointer: fine) {
        #navbar nav ul .nav-link:hover {
            color: var(--color-brand-primary);
        }
        #navbar nav ul .nav-link:hover::after {
            transform: scaleX(1);
        }
        #navbar .social-icon--instagram:hover {
            color: #ffffff;
            background-color: var(--color-instagram);
            transform: scale(1.05);
        }
        #navbar .social-icon--linkedin:hover {
            color: #ffffff;
            background-color: var(--color-linkedin);
            transform: scale(1.05);
        }
        #navbar .cta-btn:hover {
            background-color: var(--color-brand-hover);
            border-color: var(--color-brand-hover);
            transform: scale(1.03);
        }
    }

    #navbar .menu-btn:active,
    #navbar .social-icon:active,
    #navbar .cta-btn:active {
        transform: scale(0.97);
    }

    /* Estado al hacer scroll: fondo blanco, texto oscuro */
    #navbar.scrolled {
        background-color: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        box-shadow: 0 2px 16px rgba(0, 0, 0, 0.06);
        border-bottom-color: var(--color-border-light);
    }

    #navbar.scrolled nav .nav-link {
        color: var(--color-text-body);
    }

    #navbar.scrolled .menu-btn {
        color: var(--color-brand-primary);
        background-color: rgba(144, 39, 39, 0.08);
    }

    #navbar.scrolled .social-icon {
        color: var(--color-brand-primary);
        background-color: var(--color-surface-muted);
    }

    #navbar.scrolled .cta-btn {
        color: #ffffff;
        border-color: var(--color-brand-primary);
        background-color: var(--color-brand-primary);
    }

    #mobileMenu {
        min-height: 100vh;
        min-height: 100dvh;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(-8px);
        transition:
            opacity 200ms var(--ease-out),
            transform 200ms var(--ease-out),
            visibility 200ms;
    }

    #mobileMenu[data-open="true"] {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0);
    }

    #mobileMenu .nav-link {
        color: var(--color-text-heading);
        transition: color 160ms ease;
    }

    #mobileMenu .nav-link::after {
        display: none;
    }

    #mobileMenu .mobile-social {
        transition:
            transform 160ms var(--ease-out),
            background-color 160ms ease,
            color 160ms ease;
    }

    @media (hover: hover) and (pointer: fine) {
        #mobileMenu .nav-link:hover {
            color: var(--color-brand-primary);
        }
        #mobileMenu .mobile-social:hover {
            transform: scale(1.05);
        }
        #mobileMenu .mobile-social[href*="instagram"]:hover {
            color: #ffffff;
            background-color: var(--color-instagram);
        }
        #mobileMenu .mobile-social[href*="linkedin"]:hover {
            color: #ffffff;
            background-color: var(--color-linkedin);
        }
    }

    #mobileMenu .mobile-social:active {
        transform: scale(0.97);
    }

    /* En mobile el header siempre se ve "scrolled" */
    @media (max-width: 767px) {
        #navbar {
            background-color: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            box-shadow: 0 2px 16px rgba(0, 0, 0, 0.06);
            border-bottom-color: var(--color-border-light);
        }

        #navbar .nav-link {
            color: var(--color-text-body);
        }

        #navbar .menu-btn {
            color: var(--color-brand-primary);
            background-color: rgba(144, 39, 39, 0.08);
        }

        #navbar .social-icon {
            color: var(--color-brand-primary);
            background-color: var(--color-surface-muted);
        }

        #navbar .cta-btn {
            color: #ffffff;
            border-color: var(--color-brand-primary);
            background-color: var(--color-brand-primary);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #navbar.nav-hidden {
            transform: none;
        }
        #mobileMenu {
            transform: none;
            transition:
                opacity 150ms ease,
                visibility 150ms;
        }
    }
</style>

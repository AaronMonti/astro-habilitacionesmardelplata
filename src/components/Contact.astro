---
import { site } from "../config/site";

const { contact } = site;
const message = "Hola, me interesa realizar una gestión!";
const whatsappUrl = `https://wa.me/${contact.phone}?text=${encodeURIComponent(message)}`;

const inputClass =
   "h-12 w-full rounded border border-border-subtle bg-white px-4 text-text-body placeholder-text-muted transition-[border-color,box-shadow] duration-200 ease-out focus:border-brand-dark focus:outline-none focus:ring-2 focus:ring-brand-primary/25";
---

<section class="bg-white py-20" id="contacto">
   <div class="mx-auto max-w-[1200px] px-6">
      <!-- Título -->
      <div class="mb-16 text-center">
         <h2 class="mb-4 text-3xl font-bold leading-[1.3] text-text-heading">
            Contacto
         </h2>

         <div class="mx-auto mb-6 h-1 w-16 rounded bg-brand-divider"></div>

         <p class="text-lg leading-[1.6] text-text-body">
            Inicie su trámite hoy. Contáctenos para una consulta inicial.
         </p>
      </div>

      <div class="flex flex-col lg:flex-row gap-16">
         <!-- Información -->
         <div>
            <h3 class="mb-6 text-2xl font-semibold text-text-heading">
               Información de Contacto
            </h3>

            <div class="space-y-6">
               <!-- Dirección -->
               <div class="flex items-start gap-4">
                  <i class="fa-solid fa-location-dot mt-1 text-brand-dark"></i>

                  <div class="min-w-0">
                     <p class="font-bold text-text-heading">Dirección</p>

                     <p class="text-text-body">
                        CORDOBA 1882, PISO 4, OFICINA 42,<br />
                        Mar del Plata.
                     </p>
                  </div>
               </div>

               <!-- Teléfonos -->
               <div class="flex items-start gap-4">
                  <i class="fa-solid fa-phone mt-1 text-brand-dark"></i>

                  <div class="min-w-0">
                     <p class="font-bold text-text-heading">Teléfonos</p>

                     <p class="text-text-body">{contact.displayPhone}</p>

                     <p class="text-text-body">(0223) 15-564-6847</p>
                  </div>
               </div>

               <!-- Email -->
               <div class="flex items-start gap-4">
                  <i class="fa-solid fa-envelope mt-1 text-brand-dark"></i>

                  <div class="min-w-0">
                     <p class="font-bold text-text-heading">Email</p>

                     <a
                        href={`mailto:${contact.email}`}
                        class="text-brand-dark transition-colors duration-200 hover:underline"
                     >
                        {contact.email}
                     </a>
                  </div>
               </div>
            </div>

            <!-- Redes -->
            <div class="mt-8 flex gap-4">
               <a
                  href={contact.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Instagram"
                  class="contact-social contact-social--instagram flex h-10 w-10 items-center justify-center rounded-full bg-surface-muted text-text-body"
               >
                  <i class="fa-brands fa-instagram text-lg"></i>
               </a>

               <a
                  href={contact.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="LinkedIn"
                  class="contact-social contact-social--linkedin flex h-10 w-10 items-center justify-center rounded-full bg-surface-muted text-text-body"
               >
                  <i class="fa-brands fa-linkedin-in text-lg"></i>
               </a>

               <a
                  href={whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Contactar a ${contact.name} por WhatsApp`}
                  class="contact-social contact-social--whatsapp flex h-10 w-10 items-center justify-center rounded-full bg-success/10 text-success"
               >
                  <i class="fa-brands fa-whatsapp text-lg"></i>
               </a>
            </div>
         </div>

         <!-- Formulario -->
         <div class="w-full rounded-lg bg-surface-muted p-6 lg:p-10">
            <form id="contactForm" class="flex flex-col gap-4" novalidate>
               <div>
                  <label
                     class="mb-1 block text-sm font-medium text-text-heading"
                     for="name"
                  >
                     Nombre
                  </label>

                  <input
                     id="name"
                     name="name"
                     type="text"
                     autocomplete="name"
                     placeholder="Nombre"
                     required
                     aria-describedby="name-error"
                     aria-invalid="false"
                     class={inputClass}
                  />

                  <p id="name-error" class="field-error" aria-live="polite"></p>
               </div>

               <div>
                  <label
                     class="mb-1 block text-sm font-medium text-text-heading"
                     for="email"
                  >
                     Email
                  </label>

                  <input
                     id="email"
                     name="email"
                     type="email"
                     autocomplete="email"
                     placeholder="Email"
                     required
                     aria-describedby="email-error"
                     aria-invalid="false"
                     class={inputClass}
                  />

                  <p id="email-error" class="field-error" aria-live="polite"></p>
               </div>

               <div>
                  <label
                     class="mb-1 block text-sm font-medium text-text-heading"
                     for="phone"
                  >
                     Teléfono
                  </label>

                  <input
                     id="phone"
                     name="phone"
                     type="tel"
                     autocomplete="tel"
                     placeholder="Teléfono"
                     required
                     aria-describedby="phone-error"
                     aria-invalid="false"
                     class={inputClass}
                  />

                  <p id="phone-error" class="field-error" aria-live="polite"></p>
               </div>

               <div>
                  <label
                     class="mb-1 block text-sm font-medium text-text-heading"
                     for="message"
                  >
                     Mensaje
                  </label>

                  <textarea
                     id="message"
                     name="message"
                     placeholder="Mensaje"
                     required
                     aria-describedby="message-error"
                     aria-invalid="false"
                     class="h-32 w-full resize-y rounded border border-border-subtle bg-white p-4 text-text-body placeholder-text-muted transition-[border-color,box-shadow] duration-200 ease-out focus:border-brand-dark focus:outline-none focus:ring-2 focus:ring-brand-primary/25"
                  ></textarea>

                  <p id="message-error" class="field-error" aria-live="polite"></p>
               </div>

               <button
                  id="submitButton"
                  type="submit"
                  class="submit-btn h-12 w-full rounded bg-brand-dark text-sm font-semibold text-white shadow-sm"
               >
                  Enviar Mensaje
               </button>

               <p
                  id="formMessage"
                  class="min-h-5 text-center text-sm text-gray-500"
                  role="status"
                  aria-live="polite"
               ></p>
            </form>
         </div>
      </div>
   </div>
</section>

<script>
   const form = document.getElementById("contactForm") as HTMLFormElement | null;
   const formMessage = document.getElementById("formMessage");
   const submitButton = document.getElementById("submitButton") as HTMLButtonElement | null;

   if (form && formMessage) {
      const fields = Array.from(
         form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[name]"),
      );
      let isSubmitting = false;

      const messageTone: Record<string, string> = {
         pending: "text-gray-500",
         success: "text-green-600",
         error: "text-red-600",
      };

      function setMessage(text: string, tone: keyof typeof messageTone | "idle") {
         if (!formMessage) return;
         formMessage.textContent = text;
         formMessage.className = `min-h-5 text-center text-sm ${
            tone === "idle" ? "text-gray-500" : messageTone[tone]
         }`;
      }

      const validators: Record<string, (value: string) => string> = {
         name: (value) => (value.trim().length >= 2 ? "" : "Ingrese su nombre."),
         email: (value) =>
            /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value.trim())
               ? ""
               : "Ingrese un email válido.",
         phone: (value) =>
            value.replace(/\D/g, "").length >= 8
               ? ""
               : "Ingrese un teléfono válido.",
         message: (value) =>
            value.trim().length >= 10
               ? ""
               : "Ingrese un mensaje de al menos 10 caracteres.",
      };

      function validateField(field: HTMLInputElement | HTMLTextAreaElement) {
         const error = document.getElementById(`${field.name}-error`);
         const message = validators[field.name]?.(field.value) ?? "";

         if (error) error.textContent = message;
         field.setAttribute("aria-invalid", String(Boolean(message)));
         return !message;
      }

      function clearField(field: HTMLInputElement | HTMLTextAreaElement) {
         const error = document.getElementById(`${field.name}-error`);
         if (error) error.textContent = "";
         field.setAttribute("aria-invalid", "false");
      }

      fields.forEach((field) => {
         field.addEventListener("input", () => clearField(field));
      });

      form.addEventListener("submit", async (event) => {
         event.preventDefault();
         if (isSubmitting) return;

         const isValid = fields.map(validateField).every(Boolean);
         if (!isValid) {
            setMessage("Revise los campos marcados.", "error");
            fields.find((field) => field.getAttribute("aria-invalid") === "true")?.focus();
            return;
         }

         isSubmitting = true;
         submitButton?.setAttribute("disabled", "");
         submitButton?.setAttribute("aria-busy", "true");
         setMessage("Enviando mensaje...", "pending");

         try {
            const response = await fetch("sendmail.php", {
               method: "POST",
               body: new FormData(form),
            });

            if (!response.ok) throw new Error(`HTTP ${response.status}`);

            const result = (await response.json()) as {
               success?: boolean;
               error?: string;
            };
            if (!result.success) {
               throw new Error(result.error ?? "No se pudo enviar el mensaje.");
            }

            setMessage("¡Mensaje enviado con éxito!", "success");
            form.reset();
            fields.forEach(clearField);
         } catch {
            setMessage(
               "No se pudo enviar el mensaje. Intente nuevamente o contáctenos por WhatsApp.",
               "error",
            );
         } finally {
            isSubmitting = false;
            submitButton?.removeAttribute("disabled");
            submitButton?.removeAttribute("aria-busy");
         }
      });
   }
</script>

<style>
   .field-error {
      min-height: 1rem;
      margin-top: 0.25rem;
      font-size: 0.75rem;
      line-height: 1rem;
      color: #dc2626;
   }

   .contact-social,
   .submit-btn {
      transition:
         transform 160ms var(--ease-out),
         background-color 160ms ease,
         color 160ms ease;
   }

   @media (hover: hover) and (pointer: fine) {
      .contact-social:hover {
         transform: scale(1.05);
      }
      .contact-social--instagram:hover {
         color: #ffffff;
         background-color: var(--color-instagram);
      }
      .contact-social--linkedin:hover {
         color: #ffffff;
         background-color: var(--color-linkedin);
      }
      .contact-social--whatsapp:hover {
         color: #ffffff;
         background-color: var(--color-success);
      }
      .submit-btn:hover {
         background-color: var(--color-brand-divider);
         transform: scale(1.01);
      }
   }

   .contact-social:active,
   .submit-btn:active {
      transform: scale(0.97);
   }

   .submit-btn:disabled {
      opacity: 0.6;
      cursor: wait;
   }

   @media (prefers-reduced-motion: reduce) {
      .contact-social,
      .submit-btn {
         transition: background-color 150ms ease, color 150ms ease;
      }
   }
</style>

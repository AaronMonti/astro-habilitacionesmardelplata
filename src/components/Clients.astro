    { name: "arriba", logos: topLogos, reverse: false, large: true },
    { name: "medio", logos: middleLogos, reverse: true, large: false },
    { name: "abajo", logos: bottomLogos, reverse: false, large: false },
];
---

<section id="clientes" class="w-full mx-auto py-20 bg-surface-light">
    <div class="space-y-1 flex flex-col items-center mb-16">
        <h2 class="mb-4 text-3xl font-bold leading-[1.3] text-text-heading">
            Nuestros clientes
        </h2>

        <div class="mx-auto mb-6 h-1 w-16 rounded bg-brand-divider"></div>
    </div>

    {
        rows.map((row) => (
            <div class:list={["logo-row", `logo-row--${row.name}`]}>
                <div class="carousel">
                    {[0, 1].map((copy) => (
                        <div
                            aria-hidden={copy === 1 ? "true" : undefined}
                            class:list={[
                                "logo-group",
                                row.reverse && "logo-group--reverse",
                            ]}
                        >
                            {row.logos.map((logo) => (
                                <div
                                    class:list={[
                                        "logo-container",
                                        logo.onDark && "logo-container--dark",
                                    ]}
                                >
                                    <img
                                        class:list={[
                                            "item-logo",
                                            row.large && "item-logo--large",
                                            logo.onWhite && "item-logo--on-white",
                                        ]}
                                        src={logo.src}
                                        alt={copy === 1 ? "" : logo.alt}
                                        loading="lazy"
                                    />
                                </div>
                            ))}
                        </div>
                    ))}
                </div>
            </div>
        ))
    }
</section>

<style scoped>
    .logo-row {
        position: relative;
        overflow: hidden;
        background-color: color-mix(
            in srgb,
            var(--color-brand-primary) 15%,
            transparent
        );
    }

    .logo-row--medio {
        margin-block: 2.5rem;
    }

    .carousel {
        display: flex;
        margin: 0 auto;
        padding: 20px 0;
        max-width: 100%;
        overflow: hidden;
    }

    .carousel > * {
        flex: 0 0 100%;
    }

    .carousel:hover .logo-group,
    .carousel:focus-within .logo-group {
        animation-play-state: paused;
    }

    .logo-group {
        display: flex;
        align-items: center;
        gap: 20px;
        padding-right: 20px;
        animation: scrolling 30s linear infinite;
    }

    .logo-group--reverse {
        padding-right: 0;
        padding-left: 20px;
        animation-name: scrolling-reverse;
        animation-duration: 60s;
    }

    @keyframes scrolling {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(-100%);
        }
    }

    @keyframes scrolling-reverse {
        from {
            transform: translateX(-100%);
        }
        to {
            transform: translateX(0);
        }
    }

    .logo-container {
        display: flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
    }

    .logo-container--dark {
        gap: 20px;
        width: 13rem;
        height: 6rem;
        padding: 0 2rem;
        border: 1px solid var(--color-border-light);
        border-radius: 0.5rem;
        background-color: var(--color-surface-dark);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }

    .item-logo {
        max-width: 160px;
        max-height: 80px;
        object-fit: contain;
    }

    .item-logo--large {
        max-width: 300px;
        max-height: 100px;
    }

    .item-logo--on-white {
        background-color: #ffffff;
        padding: 5px;
    }

    @media (prefers-reduced-motion: reduce) {
        .carousel {
            overflow-x: auto;
            scrollbar-width: thin;
        }
        .logo-group {
            animation: none;
        }
        .logo-group[aria-hidden="true"] {
            display: none;
        }
    }
</style>

<section class="bg-surface-light py-20" id="proceso">
   <div class="mx-auto max-w-[1200px] px-6">
      <div class="mb-16 text-center">
         <h2 class="mb-4 text-3xl font-bold leading-[1.3] text-text-heading">
            Nuestro proceso
         </h2>

         <div class="mx-auto mb-6 h-1 w-16 rounded bg-brand-divider"></div>

         <p
            class="mx-auto max-w-2xl text-lg font-normal leading-[1.6] text-text-body"
         >
            Un método probado en 4 pasos para garantizar el éxito de su
            habilitación.
         </p>
      </div>

      <div class="grid gap-8 md:grid-cols-4">
         <!-- Paso 1 -->
         <div
            class="relative rounded-lg bg-white p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
         >
            <div
               class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-brand-dark/10 text-brand-dark"
            >
               <i class="fa-solid fa-magnifying-glass text-3xl"></i>
            </div>

            <div
               class="absolute -left-4 -top-4 flex h-8 w-8 items-center justify-center rounded-full bg-brand-dark font-bold text-white"
            >
               1
            </div>

            <h3 class="mb-3 text-xl font-semibold text-text-heading">
               Analisis de situación
            </h3>

            <p class="text-base leading-6 text-text-body">
               Análisis inicial de viabilidad y requisitos específicos para su
               rubro y ubicación.
            </p>
         </div>

         <!-- Paso 2 -->
         <div
            class="relative rounded-lg bg-white p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
         >
            <div
               class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-brand-dark/10 text-brand-dark"
            >
               <i class="fa-solid fa-file-lines text-3xl"></i>
            </div>

            <div
               class="absolute -left-4 -top-4 flex h-8 w-8 items-center justify-center rounded-full bg-brand-dark font-bold text-white"
            >
               2
            </div>

            <h3 class="mb-3 text-xl font-semibold text-text-heading">
               Propuesta de trabajo y presupuestacion
            </h3>

            <p class="text-base leading-6 text-text-body">
               Presentamos el alcance del servicio, los plazos y el presupuesto
               para su aprobación.
            </p>
         </div>

         <!-- Paso 3 -->
         <div
            class="relative rounded-lg bg-white p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
         >
            <div
               class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-brand-dark/10 text-brand-dark"
            >
               <i class="fa-solid fa-folder-open text-3xl"></i>
            </div>

            <div
               class="absolute -left-4 -top-4 flex h-8 w-8 items-center justify-center rounded-full bg-brand-dark font-bold text-white"
            >
               3
            </div>

            <h3 class="mb-3 text-xl font-semibold text-text-heading">
               Armado de legajo y ajustes preventivos antes de la presentación
            </h3>

            <p class="text-base leading-6 text-text-body">
               Preparamos la documentación y verificamos el cumplimiento de los
               requisitos antes de presentar el expediente.
            </p>
         </div>

         <!-- Paso 4 -->
         <div
            class="relative rounded-lg bg-white p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
         >
            <div
               class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-success/10 text-success"
            >
               <i class="fa-solid fa-clipboard-check text-3xl"></i>
            </div>

            <div
               class="absolute -left-4 -top-4 flex h-8 w-8 items-center justify-center rounded-full bg-success font-bold text-white"
            >
               4
            </div>

            <h3 class="mb-3 text-xl font-semibold text-text-heading">
               Inicio de trámite y seguimiento hasta su finalización
            </h3>

            <p class="text-base leading-6 text-text-body">
               Gestionamos el expediente y realizamos el seguimiento hasta la
               obtención de la habilitación.
            </p>
         </div>
      </div>
   </div>
</section>
